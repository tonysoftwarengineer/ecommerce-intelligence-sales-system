# Local development only. Copy to the ignored .env file and fill these values.
# Never commit a real API key.
GEMINI_API_KEY=
GROQ_API_KEY=
# Groq is the recommended local provider for experimental grounded answers.
# Set RAG_ANSWER_PROVIDER=gemini and choose a Gemini model to use Gemini instead.
RAG_ANSWER_MODEL=openai/gpt-oss-20b
RAG_ANSWER_PROVIDER=groq
RAG_ANSWER_MAX_OUTPUT_TOKENS=1024
RAG_ANSWER_RATE_LIMIT_PER_MINUTE=6
# App-wide cap on provider-backed answers per UTC day, across all visitors.
RAG_ANSWER_DAILY_BUDGET=100
# Leave disabled except while inspecting aggregate local development metrics.
# Enabling requires a token (the app refuses to start without one); send it as
# "Authorization: Bearer <token>". Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
DEVELOPMENT_OBSERVABILITY_ENABLED=false
DEVELOPMENT_OBSERVABILITY_TOKEN=
